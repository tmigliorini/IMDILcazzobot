TELOXIDE_TOKEN=0123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RUST_LOG=info

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dickgrowerbotdb
POSTGRES_USER=dickgrowerbot
POSTGRES_PASSWORD=dgb4pwd

# DATABASE_URL is required to run a plain binary executable file for dev environment
# this line is ignored and built from the components above in `docker-compose.yml`
DATABASE_URL=postgres://dickgrowerbot:dgb4pwd@localhost:5432/dickgrowerbotdb
DATABASE_MAX_CONNECTIONS=10

# directory with syntax.html and intro.html, loaded fresh at startup (no rebuild needed to edit
# them, just restart - e.g. ./reload-env.sh). docker-compose.yml overrides this to /bot-text
# (the mounted volume path); this value is only used when running the plain binary directly.
BOT_TEXT_DIR=bot-text

HELP_ADMIN_CHANNEL_RU=kozaloru
HELP_ADMIN_CHANNEL_EN=kozalo_blog
HELP_ADMIN_CHAT_RU=kozaloru_chat
HELP_ADMIN_CHAT_EN=kozalo_blog_chat
HELP_GIT_REPO=https://github.com/kozalosev/DickGrowerBot

CHATS_MERGING_ENABLED=true
TOP_UNLIMITED_ENABLED=true
MULTIPLE_LOANS_ENABLED=false
PVP_CHECK_ACCEPTOR_LENGTH=false
PVP_CALLBACK_LOCKS_ENABLED=true

#PVP_STATS_SHOW=false
#PVP_STATS_SHOW_NOTICE=true
#DISABLE_CMD_STATS=true
#DISABLE_CMD_COMBO=true

GROWTH_MIN=-5
GROWTH_MAX=10
GROW_SHRINK_RATIO=0.5
GROWTH_DOD_BONUS_MAX=5
NEWCOMERS_GRACE_DAYS=7
TOP_LIMIT=25
PVP_DEFAULT_BET=1
DONATE_DEFAULT_AMOUNT=5

# disabled by default (changes the 50/50 odds of every PVP battle); set to true to enable
#PVP_SKILL_BASED_PROBABILITY=true

# /tax: taxes the top TAX_TOP_RANKS players, each paying a share of TAX_MAX_RATE (their own
# length) proportional to how far they stand out from the rest of that group (normalized
# distance to the benchmark - the next-best player just below the taxed group); a dominant
# outlier pays close to the full TAX_MAX_RATE, a player close to the pack pays close to nothing.
# the collected pool is redistributed to the bottom TAX_BOTTOM_RANKS players, proportional to
# how far below THEIR OWN benchmark (the player just above that group) each of them is - the
# neediest gets the largest share, players equally needy (including a chat-wide tie) split evenly.
# leave TAX_TOP_RANKS or TAX_BOTTOM_RANKS at 0 to keep /tax disabled.
TAX_TOP_RANKS=3
TAX_MAX_RATE=0.43
TAX_BOTTOM_RANKS=3

# Perks
HELP_PUSSIES_COEF=0.01
LOAN_PAYOUT_COEF=0.1

# P2P loans (/presta)
P2P_LOAN_DEFAULT_AMOUNT=10
P2P_LOAN_INTEREST_RATE=0.1
P2P_LOAN_PAYOUT_RATIO=0.1
# tax on the loan's interest (not the principal), withheld from the lender right away and
# redistributed to the bottom TAX_BOTTOM_RANKS players, same method as /tax; 0 disables it
P2P_LOAN_INTEREST_TAX_RATE=0.0

# How to select winners of DoD? Possible options:
# 1) RANDOM - completely random
# 2) EXCLUSION - exclude TOP-N% (10% if ratio is 0.1)
# 3) WEIGHTS - the less your dick is the more chances you have
DOD_SELECTION_MODE=EXCLUSION
DOD_RICH_EXCLUSION_RATIO=0.1

# Announcements are displayed at the end of the Dick of the Day message, not more than a specified amount of times.
ANNOUNCEMENT_MAX_SHOWS=5
#ANNOUNCEMENT_EN=
#ANNOUNCEMENT_RU=

# to enable Webhook Mode, set to a correct URL, proxied by a reverse proxy server
#WEBHOOK_URL=https://your.domain/DickGrowerBot/webhook
